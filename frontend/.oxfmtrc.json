{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist", "node_modules", "**/*.md"],
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve"
}
